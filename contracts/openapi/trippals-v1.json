{
  "openapi": "3.1.0",
  "info": {
    "title": "TripPals API",
    "version": "1.0.0",
    "description": "Versioned public API contract. Product resource endpoints are added only with their authorization-specific schemas and contract tests."
  },
  "paths": {
    "/up": {
      "get": {
        "operationId": "healthCheck",
        "responses": {
          "200": {"description": "Service process is healthy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "readinessCheck",
        "responses": {
          "200": {"description": "Required local dependencies are ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}},
          "503": {"description": "A required dependency is unavailable", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/hello": {
      "get": {
        "operationId": "apiHello",
        "responses": {
          "200": {"description": "API reachability response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}
        }
      }
    },
    "/v1/cities": {
      "get": {
        "operationId": "listCities",
        "responses": {
          "200": {"description": "Supported and unavailable city metadata", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}
        }
      }
    },
    "/v1/activities": {
      "get": {
        "operationId": "listActivities",
        "parameters": [
          {"name": "city_id", "in": "query", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "start_local_date", "in": "query", "schema": {"type": "string", "format": "date"}},
          {"name": "end_local_date", "in": "query", "schema": {"type": "string", "format": "date"}},
          {"name": "category", "in": "query", "schema": {"type": "string"}},
          {"name": "min_capacity", "in": "query", "schema": {"type": "integer", "minimum": 2, "maximum": 10}},
          {"name": "max_capacity", "in": "query", "schema": {"type": "integer", "minimum": 2, "maximum": 10}},
          {"name": "cursor", "in": "query", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Guest-safe scheduled activities", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}},
          "404": {"description": "City not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "Invalid range or unavailable city", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "post": {
        "operationId": "createActivityDraft",
        "security": [{"bearerAuth": []}],
        "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "201": {"description": "Host-owned activity draft", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}},
          "403": {"description": "Ineligible host", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/activities/{id}": {
      "get": {
        "operationId": "getActivity",
        "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "200": {"description": "Guest-safe activity detail", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}},
          "404": {"description": "Activity not found", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "410": {"description": "Activity is no longer publicly available", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "patch": {
        "operationId": "updateActivity",
        "security": [{"bearerAuth": []}],
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}},
          {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {"description": "Updated host activity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}},
          "409": {"description": "Stale activity version", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/activity-ideas": {
      "get": {
        "operationId": "listActivityIdeas",
        "responses": {
          "200": {"description": "Non-joinable activity templates", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}
        }
      }
    },
    "/v1/activities/{id}/publish": {"post": {"operationId": "publishActivity", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Published activity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/activities/{id}/confirm": {"post": {"operationId": "confirmActivity", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Host-confirmed activity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/activities/{id}/start": {"post": {"operationId": "startActivity", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "In-progress activity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/activities/{id}/finish": {"post": {"operationId": "finishActivity", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Host-reported outcome", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/activities/{id}/cancel": {"post": {"operationId": "cancelActivity", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Canceled activity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/me": {"delete": {"operationId": "requestAccountDeletion", "security": [{"bearerAuth": []}], "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}}], "responses": {"202": {"description": "Deletion workflow initiated; access is revoked immediately", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}, "403": {"description": "Recent authentication required", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}},
    "/v1/activities/{id}/interest": {"post": {"operationId": "expressActivityInterest", "security": [{"bearerAuth": []}], "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Interest state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/activities/{id}/join": {"post": {"operationId": "joinActivity", "security": [{"bearerAuth": []}], "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Going state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}, "409": {"description": "Activity full or idempotency conflict", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}}}},
    "/v1/activities/{id}/leave": {"post": {"operationId": "leaveActivity", "security": [{"bearerAuth": []}], "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Left state and revoked future chat access", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/activities/{id}/reconfirm": {"post": {"operationId": "reconfirmActivity", "security": [{"bearerAuth": []}], "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["answer"], "properties": {"answer": {"type": "string", "enum": ["yes"]}}}}}}, "responses": {"200": {"description": "Explicit reconfirmation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/activities/{id}/attendance": {"post": {"operationId": "reportActivityAttendance", "security": [{"bearerAuth": []}], "parameters": [{"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Self-reported attendance", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}},
    "/v1/me/plans": {"get": {"operationId": "listMyPlans", "security": [{"bearerAuth": []}], "parameters": [{"name": "cursor", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 50}}], "responses": {"200": {"description": "Cursor-paginated Going, Interested, Hosting, Past, and terminal plans", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Success"}}}}}}}
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "TripPals access token"}
    },
    "schemas": {
      "Success": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": {"type": "object"},
          "meta": {"$ref": "#/components/schemas/Meta"}
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "meta"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "fields": {"type": "object"},
              "current": {"type": "object"}
            }
          },
          "meta": {"$ref": "#/components/schemas/Meta"}
        }
      },
      "Meta": {
        "type": "object",
        "required": ["correlation_id"],
        "properties": {
          "correlation_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
