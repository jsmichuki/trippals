# Local development only. Never use these values outside a developer machine.
API_PORT=4000

# API request and browser-access policy. Production/staging values are injected
# by the deployment secret/configuration manager, never committed here.
API_MAX_BODY_BYTES=1000000
CORS_ORIGINS=http://localhost:3000

# Invitation matching is deliberately disabled unless a reviewed city UUID is
# explicitly listed by the deployment configuration. Keep this empty locally.
TRIPPALS_INVITATION_MATCHING_CITY_IDS=

# PostgreSQL 14 is run directly through Homebrew, not Docker.
# These local-only credentials match the configured local `postgres` role.
DATABASE_URL=ecto://postgres:postgres@127.0.0.1:5432/trip_pals_dev
TEST_DATABASE_URL=ecto://postgres:postgres@127.0.0.1:5432/trip_pals_test
